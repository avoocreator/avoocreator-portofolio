# Supabase (WAJIB) — ambil di Project Settings → API pada dashboard Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role-key-kamu>

# ---- Opsional ----
# Akun admin awal (dipakai SEKALI saat database pertama kali di-seed). Sangat disarankan di produksi.
# Kalau kosong: admin / avoo2026 — dan panel admin akan menampilkan peringatan sampai password diganti.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=ganti-dengan-password-panjang

# Alamat situs untuk sitemap.xml & robots.txt
# NEXT_PUBLIC_SITE_URL=https://domain-kamu.com

# Lama cache konten publik di memori server (milidetik). Default 30000 = 30 detik; 0 = matikan cache.
# Perubahan dari panel admin langsung terlihat di instance yang sama; instance lain menyusul sesuai nilai ini.
# CONTENT_CACHE_TTL_MS=30000
